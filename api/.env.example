# ─────────────────────────────────────────────
# Portfolio API — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to source control
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://alvaromerino.dev,http://localhost:5500

# ── Email (Nodemailer) ──────────────────────
# Use any SMTP provider (e.g. Brevo, SendGrid, Gmail OAuth2)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="Alvaro Merino <no-reply@alvaromerino.dev>"
MAIL_TO=alvaromerinopuerta@gmail.com

# ── GitHub Proxy ────────────────────────────
# Optional Personal Access Token (increases rate limit from 60 to 5000 req/h)
GITHUB_TOKEN=
GITHUB_USERNAME=AlvaroMerinoP
# Cache duration in seconds (default: 3600 = 1 hour)
GITHUB_CACHE_TTL=3600

# ── Analytics ───────────────────────────────
# Shared secret for the /api/analytics endpoint
ANALYTICS_SECRET=change-me-in-production
